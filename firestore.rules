rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /apurwa_dohale_votes/{doc} {
      allow read, write: if false;
    }
    match /apurwa_baby_names/{doc} {
      allow read, write: if false;
    }
    match /apurwa_dohale_meta/{doc} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
